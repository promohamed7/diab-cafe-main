# Public build-time configuration. Every VITE_* value ends up in the browser
# bundle: never put secrets or Café credentials here.

# ---- Café integration ----
# 'http' (production default) or 'mock' (development default; sample cafés, fake orders never reach a café)
VITE_CAFE_TRANSPORT=http
# Base URL of the INBYTE Café integration adapter/relay. Leave empty until it exists:
# the site then shows "online ordering unavailable" instead of faking orders.
VITE_CAFE_API_BASE_URL=
# Request timeout in milliseconds
VITE_CAFE_API_TIMEOUT_MS=15000
# Query parameter that carries the café's table token in table QR URLs
VITE_TABLE_QR_PARAM=table

# ---- Tenant (café) resolution ----
# fixed | subdomain | path
VITE_TENANT_STRATEGY=fixed
# Café for the 'fixed' strategy (and fallback for the others)
VITE_TENANT_ID=
# subdomain strategy: <tenantId>.<VITE_TENANT_BASE_DOMAIN>
VITE_TENANT_BASE_DOMAIN=
# path strategy: /<VITE_TENANT_PATH_PREFIX>/<tenantId>/
VITE_TENANT_PATH_PREFIX=t
# Custom domains, checked first, e.g. {"cafe-x.com":"cafe-x"}
VITE_TENANT_HOST_MAP=
# Where café configuration is loaded from: 'static' (/tenants/<tenantId>.json) or 'api' (relay)
VITE_TENANT_CONFIG_SOURCE=static
