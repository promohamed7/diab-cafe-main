# =====================================================================
# Backend (server/) — server-side only. Never expose these to the browser.
# =====================================================================
DATABASE_URL=postgres://inbyte:change-me@localhost:5432/inbyte
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
# Built frontend (customer site + /admin) served by the backend
STATIC_DIR=dist
# Number of trusted reverse proxies in front of the server (client IP / https detection)
TRUST_PROXY_HOPS=1
# Public URL of a café without a primary domain ({origin}, {tenantId}); used for QR codes
SITE_URL_TEMPLATE={origin}/t/{tenantId}/
# Extra origins allowed to read the public API cross-origin (comma separated; none needed same-origin)
PUBLIC_CORS_ORIGINS=
# Extra origins allowed to send admin mutations (comma separated; same host is always allowed)
ADMIN_ORIGINS=
CONNECTOR_OFFLINE_AFTER_SECONDS=90
ORDER_LEASE_SECONDS=60
CUSTOMER_DATA_RETENTION_DAYS=30
ADMIN_SESSION_HOURS=12
ADMIN_SESSION_IDLE_MINUTES=120
# Development only: secure cookies are forced on in production
COOKIE_SECURE=false

# =====================================================================
# Customer website build (VITE_*) — public: every value ends up in the bundle.
# =====================================================================
# 'http' (production default) or 'mock' (npm run dev default; fake orders never reach a café)
VITE_CAFE_TRANSPORT=http
# Platform public API; default same origin. 'none' disables ordering.
VITE_CAFE_API_BASE_URL=/api/public/v1
VITE_CAFE_API_TIMEOUT_MS=15000
VITE_TABLE_QR_PARAM=table
# platform (default: /t/<id>/ paths, then the backend maps the hostname) | fixed | subdomain | path
VITE_TENANT_STRATEGY=platform
VITE_TENANT_ID=
VITE_TENANT_BASE_DOMAIN=
VITE_TENANT_PATH_PREFIX=t
VITE_TENANT_HOST_MAP=
# api (default, managed in the INBYTE Admin) | static (/tenants/<id>.json — demo/bootstrap only)
VITE_TENANT_CONFIG_SOURCE=api
