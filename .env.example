# Public build-time configuration. Every VITE_* value ends up in the browser
# bundle: never put secrets or Café credentials here.

# 'http' (production default) or 'mock' (development default; fake orders, never reach a café)
VITE_CAFE_TRANSPORT=http

# Base URL of the INBYTE Café integration adapter/relay. Leave empty until Café
# provides one: the site then shows "online ordering unavailable" instead of faking orders.
VITE_CAFE_API_BASE_URL=

# Request timeout in milliseconds
VITE_CAFE_API_TIMEOUT_MS=15000

# Query parameter that carries the Café table token in table QR URLs
VITE_TABLE_QR_PARAM=table
